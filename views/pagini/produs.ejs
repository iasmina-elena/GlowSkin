<!DOCTYPE html>
<html lang="ro">

<head>
    <%- include("../fragmente/head.ejs") %>
</head>

<body>

    <%- include("../fragmente/header.ejs") %>

    <main class="pagina-produs">

        <article class="produs-complet">

            <h1><%= prod.nume %></h1>

            <img
                src="<%= prod.imagine %>"
                alt="<%= prod.nume %>"
            >

            <p><b>Categorie:</b> <%= prod.categorie %></p>

            <p><b>Tip produs:</b> <%= prod.tip_produs %></p>

            <p><b>Preț:</b> <%= prod.pret %> lei</p>

            <p><b>Volum:</b> <%= prod.volum_ml %> ml</p>

            <p><b>Tip ten:</b> <%= prod.tip_ten %></p>

            <p><b>Ingrediente:</b> <%= prod.ingrediente %></p>

            <p><b>Vegan:</b> <%= prod.vegan ? "Da" : "Nu" %></p>

            <p>
                <b>Data adăugării:</b>

                <time datetime="<%= prod.data_adaugare %>">

                    <%= new Date(prod.data_adaugare).toLocaleDateString(
                        "ro-RO",
                        {
                            weekday:"long",
                            year:"numeric",
                            month:"long",
                            day:"numeric"
                        }
                    ) %>

                </time>

            </p>

            <p class="descriere-completa">
                <%= prod.descriere %>
            </p>

        </article>

    </main>

    <%- include("../fragmente/footer.ejs") %>

</body>

</html>